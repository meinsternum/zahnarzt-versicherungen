---
import { mitMarke } from '../lib/marke';
// Kontaktseite. Daten aus dem Impressum (src/lib/site.ts). Neue Sätze: zur Freigabe (Meilenstein 3).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BewertungKarte from '../components/BewertungKarte.astro';
import { terminLink, ORGANISATION as O, SITE_URL, SOCIAL } from '../lib/site';
import { isProduction } from '../lib/status';
import { organisation, ORG_ID } from '../lib/schema';

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Kontakt', url: `${SITE_URL}/kontakt`, inLanguage: 'de', about: { '@id': ORG_ID } },
  organisation(),
];
const firma = mitMarke(O.name);
const profile = SOCIAL.filter((s) => s.url);
const LINKTEXT: Record<string, string> = { WhatsApp: 'Nachricht schreiben', LinkedIn: 'Profil von meinsternum', Instagram: 'Profil von Patrick Senn' };
const fehlend = SOCIAL.filter((s) => !s.url).map((s) => s.name);
---
<Base title="Kontakt | zahnarzt-versicherungen.de" description="So erreichst du das Team hinter zahnarzt-versicherungen.de: Termin online wählen, Telefon, E-Mail oder vor Ort in Köln." path="/kontakt" jsonLd={jsonLd} krumen={[{ name: 'Kontakt', href: '/kontakt' }]} krumenImKopf>
  <div class="uebersichtsseite kt-seite">
    <header class="a-hero u-hero">
      <div class="rahmen">
        <nav class="a-krumen" aria-label="Brotkrumen">
          <ol>
            <li><a href="/">Startseite</a></li>
            <li><span aria-current="page">Kontakt</span></li>
          </ol>
        </nav>
        <div class="u-hero-text">
          <h1>Kontakt</h1>
          <p class="t-einleitung">Am einfachsten wählst du online einen Termin für ein Erstgespräch. Es ist kostenlos, dauert in der Regel etwa eine Stunde und findet digital per Zoom, telefonisch oder vor Ort in Köln statt.</p>
          <p><a class="cta-neu-knopf" href={terminLink('kontakt')}>Termin wählen</a></p>
        </div>
      </div>
      <svg class="a-welle" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V30C240 0 480 0 720 22s480 30 720 8V60z" /></svg>
    </header>

    <section class="kt-wege" aria-labelledby="wege-h">
      <div class="rahmen">
        <h2 id="wege-h">Weitere Wege</h2>
        <ul class="kt-karten">
          <li class="kt-karte"><span class="kt-kachel" aria-hidden="true"><Icon name="telefon" size={26} /></span><h3>Telefon</h3><p><a href={O.telefonLink}>{O.telefon}</a></p></li>
          <li class="kt-karte"><span class="kt-kachel" aria-hidden="true"><Icon name="mail" size={26} /></span><h3>E-Mail</h3><p><a href={`mailto:${O.email}`}>{O.email}</a></p></li>
          <li class="kt-karte"><span class="kt-kachel" aria-hidden="true"><Icon name="praxis" size={26} /></span><h3>Anschrift</h3><p><a href={O.url} set:html={firma} /><br />{O.strasse}<br />{O.plz} {O.ort}</p></li>
          {profile.map((s) => <li class="kt-karte"><span class="kt-kachel" aria-hidden="true"><Icon name={s.name === 'WhatsApp' ? 'chat' : 'profil'} size={26} /></span><h3>{s.name}</h3><p><a href={s.url}>{LINKTEXT[s.name] ?? s.name}</a></p></li>)}
        </ul>
        {!isProduction && fehlend.length > 0 && <p class="grafik-platzhalter">[PLATZHALTER: {fehlend.join(', ')}] Nummer und Links liefert Patrick. Nur in der Vorschau sichtbar.</p>}
        <BewertungKarte class="kt-bewertung" />
      </div>
    </section>
  </div>
  <div class="abstand-unten"></div>
</Base>
