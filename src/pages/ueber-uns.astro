---
import Bewertung from '../components/Bewertung.astro';
import Base from '../layouts/Base.astro';
import { zeigeUeberUns } from '../lib/status';

if (!zeigeUeberUns) return new Response(null, { status: 404 });

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Über uns',
  url: 'https://zahnarzt-versicherungen.de/ueber-uns',
  inLanguage: 'de',
  about: {
    '@type': 'Organization',
    name: 'MEIN STERNUM Finanzberatung GmbH',
    url: 'https://www.meinsternum.de',
    address: { '@type': 'PostalAddress', streetAddress: 'Göppinger Str. 2a', postalCode: '50739', addressLocality: 'Köln', addressCountry: 'DE' },
    founder: { '@type': 'Person', name: 'Patrick Senn', jobTitle: 'Geschäftsführer' },
  },
}];
---
<Base title="Über uns | zahnarzt-versicherungen.de" description="Wer hinter zahnarzt-versicherungen.de steht: das Team der MEIN STERNUM Finanzberatung GmbH in Köln." path="/ueber-uns" jsonLd={jsonLd}>
  <h1>Über uns</h1>
  <p>zahnarzt-versicherungen.de ist ein Angebot der MEIN STERNUM Finanzberatung GmbH aus Köln. Wir beraten Ärzt*innen in allen Karrierephasen zu Versicherungen, Finanzanlagen, Finanzierung und Niederlassung.</p>

  <h2>Patrick Senn</h2>
  <img class="portrait" src="/bilder/patrick-senn-portrait.webp" alt="Patrick Senn, Geschäftsführer" width="160" height="160" loading="lazy" />
  <p>Patrick Senn hat die MEIN STERNUM Finanzberatung GmbH 2015 mitgegründet und ist seitdem Geschäftsführer. Er hat 2008 als Berater bei der HORBACH Wirtschaftsberatung in Köln begonnen und berät seitdem Ärzt*innen. Seine Schwerpunkte sind Versicherungen und Investmentanlagen. Er schreibt und verantwortet die Texte auf dieser Seite.</p>

  <h2>Das Team</h2>
  <img class="teamfoto" src="/bilder/team-meinsternum.webp" alt="Mitglieder des Beratungsteams im Freien am Wasser" width="1600" height="1066" loading="lazy" />
  <p class="meta">Auf dem Foto ist ein Teil des Teams zu sehen.</p>
  <ul class="liste">
    <li><strong>Aileen Scherer</strong>: Partnerin, im Team seit 2017. Schwerpunkte: Versicherungen, Immobilien als Kapitalanlage, Onlinemarketing.</li>
    <li><strong>Michael Elsner</strong>: Arzt- und Unternehmensberater, im Team seit August 2023. Schwerpunkte: Berufsstart, Niederlassung und Existenzgründung.</li>
    <li><strong>Alexios Karantonis</strong>: Versicherungsmakler, im Team seit Januar 2024. Schwerpunkte: private Krankenversicherung, Berufsunfähigkeit, Altersvorsorge.</li>
    <li><strong>Fatma Gözel-Bußmann</strong>: Finanzmaklerin, im Team seit 2020. Schwerpunkte: Berufsunfähigkeit, private Krankenversicherung, Altersvorsorge.</li>
    <li><strong>Frank Schmidt</strong>: Fachwirt für Finanzberatung (IHK), im Team seit Januar 2023. Schwerpunkte: Kapitalanlage und Altersvorsorge.</li>
    <li><strong>Steffen Weber</strong>: Schwerpunkte: Altersvorsorge und Investment.</li>
    <li><strong>Henry Momberger</strong>: Finanzplaner, im Team seit 2017. Schwerpunkt: Immobilienfinanzierung.</li>
    <li><strong>Kirsten Zimmermann</strong>: Im Team seit 2021. Ansprechpartnerin für Sachversicherungen, unterstützt die Organisation.</li>
    <li><strong>Eva Janßen</strong>: Assistentin in den Bereichen Versicherungen und Kundenkommunikation.</li>
    <li><strong>Vanessa Steuer</strong>: Im Team seit Februar 2022. Telefon und Social Media.</li>
  </ul>
  <p class="meta">Angaben nach meinsternum.de/wir, Stand 12.11.2026.</p>

  <Bewertung />
  <div class="cta">
    <p>Du möchtest wissen, was für deine Situation gilt? Im Erstgespräch gehen wir sie gemeinsam durch.</p>
    <a class="btn" href="https://meinsternum.de/online-buchen">Erstgespräch buchen</a>
  </div>
</Base>
