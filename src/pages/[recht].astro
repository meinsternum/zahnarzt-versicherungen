---
// Rechtstexte (Impressum, Datenschutz, Erstinformation): nur Rahmen. Inhalte unverändert aus src/content/rechtliches.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { visible, isProduction } from '../lib/status';

export async function getStaticPaths() {
  const alle = visible(await getCollection('rechtliches'));
  return alle.map((entry) => ({ params: { recht: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const PDF = '/downloads/erstinformation-meinsternum.pdf';
const istErstinfo = entry.id === 'erstinformation';
---
<Base title={`${entry.data.titel} | zahnarzt-versicherungen.de`} description={`${entry.data.titel} von zahnarzt-versicherungen.de`} path={`/${entry.id}`} krumen={[{ name: entry.data.titel, href: `/${entry.id}` }]} krumenImKopf>
  <div class="uebersichtsseite rt-seite">
    <header class="a-hero u-hero">
      <div class="rahmen">
        <nav class="a-krumen" aria-label="Brotkrumen">
          <ol>
            <li><a href="/">Startseite</a></li>
            <li><span aria-current="page">{entry.data.titel}</span></li>
          </ol>
        </nav>
        <div class="u-hero-text">
          <h1>{entry.data.titel}</h1>
          {istErstinfo && <p class="t-einleitung">Angaben zu uns und unserer Erlaubnis, wie sie vor einer Beratung mitzuteilen sind. Du kannst sie hier als PDF herunterladen und speichern.</p>}
        </div>
      </div>
      <svg class="a-welle" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60V30C240 0 480 0 720 22s480 30 720 8V60z" /></svg>
    </header>
    <section class="rt-flaeche">
      <div class="rahmen">
        {!isProduction && entry.data.status !== 'freigegeben' && <p class="vorschau-hinweis">Rechtstext im Entwurf: Inhalt prüft und gibt Patrick frei. Nur in der Vorschau sichtbar.</p>}
        <div class="rt-karte">
          {istErstinfo && (
            <a class="rt-download" href={PDF} download>
              <span class="kt-kachel" aria-hidden="true"><Icon name="dokument" size={26} /></span>
              <span class="rt-download-text"><strong>Erstinformation als PDF herunterladen</strong><span>PDF, Stand 28.11.2026</span></span>
              <Icon name="runter" size={22} />
            </a>
          )}
          <div class="prosa recht">
            <Content />
          </div>
        </div>
      </div>
    </section>
  </div>
  <div class="abstand-unten"></div>
</Base>
