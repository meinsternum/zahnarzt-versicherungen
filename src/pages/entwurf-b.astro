---
// Startseiten-Entwurf B: Verlauf aus dem Logo, Karten, mehr Fläche. noindex, nicht in der Sitemap.
import Entwurf from '../layouts/Entwurf.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import Bewertungszeile from '../components/Bewertungszeile.astro';
import EntwurfMarke from '../components/EntwurfMarke.astro';
import { ladeStartseite } from '../lib/startseite-daten';
import { hero, themen, ablauf, werWirSind, faq, abschluss } from '../lib/startseite';
import { TERMIN_URL } from '../lib/site';
import { zeigeUeberUns } from '../lib/status';

const { gruppen, themenLinks, jsonLd } = await ladeStartseite();
const schrittIcons = ['kalender', 'gespraech', 'dokument'] as const;
---
<Entwurf title="Entwurf B: Startseite | zahnarzt-versicherungen.de" description="Startseiten-Entwurf B zur Auswahl." variante="b" bezeichnung="Startseiten-Entwurf B" jsonLd={jsonLd} themenLinks={themenLinks}>
  <section class="b-hero">
    <div class="rahmen b-hero-raster">
      <div class="b-hero-text">
        <h1>{hero.h1}</h1>
        <p class="b-lead">{hero.lead.text} {hero.lead.entwurf && <EntwurfMarke />}</p>
        <p class="b-knoepfe">
          <a class="knopf knopf-hell" href={TERMIN_URL}>{hero.cta}<Icon name="pfeil" size={18} /></a>
          <a class="knopf b-knopf-glas" href="#themen">{hero.zweit}</a>
        </p>
        <Bewertungszeile kompakt class="b-hero-bewertung" />
      </div>
      <figure class="b-hero-bild">
        <Foto foto="patrick-05-quadrat" prioritaet sizes="(min-width: 900px) 40vw, 88vw" breiten={[400, 600, 800, 1000]} />
        <figcaption>Patrick Senn, Geschäftsführer</figcaption>
      </figure>
    </div>
  </section>

  <section class="b-abschnitt b-themen" id="themen" aria-labelledby="themen-h">
    <div class="rahmen">
      <h2 id="themen-h" class="b-titel">{themen.h2}</h2>
      {gruppen.map((g) => (
        <div class="b-gruppe">
          <h3 class="b-gruppe-titel"><span class="b-icon-kreis"><Icon name={g.icon} size={20} /></span>{g.titel}</h3>
          <ul class="b-karten">
            {g.seiten.map((s) => (
              <li class="b-karte einblenden">
                <h4><a href={`/ratgeber/${s.id}`}>{s.data.frage}</a></h4>
                <p>{s.data.kurzantwort}</p>
                <span class="b-karte-mehr" aria-hidden="true">Antwort lesen <Icon name="pfeil" size={16} /></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="b-abschnitt b-ablauf" aria-labelledby="ablauf-h">
    <div class="rahmen">
      <h2 id="ablauf-h" class="b-titel">{ablauf.h2} {ablauf.entwurf && <EntwurfMarke />}</h2>
      <div class="b-ablauf-raster">
        <ol class="b-schritte">
          {ablauf.schritte.map((s, i) => (
            <li class="einblenden">
              <span class="b-icon-kreis gross"><Icon name={schrittIcons[i]} size={22} /></span>
              <div>
                <h3><span class="b-schritt-nr">Schritt {i + 1}</span>{s.titel}</h3>
                <p>{s.text} {s.platzhalter && <span class="platzhalter">[PLATZHALTER: {s.platzhalter}]</span>}</p>
              </div>
            </li>
          ))}
        </ol>
        <figure class="b-ablauf-bild einblenden">
          <Foto foto="kollege-02" sizes="(min-width: 900px) 44vw, 92vw" />
        </figure>
      </div>
    </div>
  </section>

  <section class="b-abschnitt" aria-labelledby="wer-h">
    <div class="rahmen">
      <div class="b-wer einblenden">
        <figure class="b-wer-bild">
          <Foto foto="gruppe-01" sizes="(min-width: 900px) 30vw, 92vw" breiten={[400, 600, 800]} />
        </figure>
        <div class="b-wer-text">
          <h2 id="wer-h" class="b-titel">{werWirSind.h2}</h2>
          {werWirSind.absaetze.map((p) => <p>{p}</p>)}
          {zeigeUeberUns && <p><a class="b-mehr" href="/ueber-uns">{werWirSind.link}<Icon name="pfeil" size={16} /></a></p>}
          <Bewertungszeile />
        </div>
      </div>
    </div>
  </section>

  <section class="b-abschnitt b-faq-abschnitt" aria-labelledby="faq-h">
    <div class="rahmen">
      <h2 id="faq-h" class="b-titel">{faq.h2} {faq.entwurf && <EntwurfMarke />}</h2>
      <dl class="b-faq">
        {faq.eintraege.map((f) => (
          <div class="einblenden">
            <dt>{f.frage}</dt>
            <dd>{f.antwort}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="b-abschluss" aria-labelledby="abschluss-h">
    <div class="rahmen b-abschluss-innen einblenden">
      <h2 id="abschluss-h">{abschluss.h2}</h2>
      <p>{abschluss.text}</p>
      <p><a class="knopf knopf-hell" href={TERMIN_URL}>{hero.cta}<Icon name="pfeil" size={18} /></a></p>
      <Bewertungszeile kompakt class="b-auf-dunkel" />
    </div>
  </section>
</Entwurf>

<style is:global>
  .vb .kopf { background: rgba(255, 255, 255, 0.94); }
  .vb .b-hero { background: var(--verlauf); color: #fff; padding: clamp(2.5rem, 6vw, 5rem) 0 0; overflow: hidden; }
  .vb .b-hero-raster { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: end; }
  .vb .b-hero-text { padding-bottom: clamp(2.5rem, 6vw, 5rem); }
  .vb .b-hero h1 { color: #fff; font-size: clamp(2.2rem, 4.8vw, 3.7rem); font-weight: 650; line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 1.4rem; }
  .vb .b-lead { font-size: clamp(1.06rem, 1.35vw, 1.2rem); color: #e8eef6; max-width: 35rem; margin-bottom: 2rem; }
  .vb .b-knoepfe { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; }
  .vb .b-knopf-glas { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.45); color: #fff; }
  .vb .b-knopf-glas:hover { background: rgba(255, 255, 255, 0.2); color: #fff; box-shadow: none; }
  .vb .b-hero-bewertung { display: inline-flex; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 14px; padding: 0.7rem 1rem; color: #e8eef6; max-width: 34rem; }
  .vb .b-hero-bewertung strong, .vb .b-hero-bewertung .sterne, .vb .b-hero-bewertung a { color: #fff; }
  .vb .b-hero-bild { margin: 0; position: relative; }
  .vb .b-hero-bild img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 32px 32px 0 0; }
  .vb .b-hero-bild figcaption { position: absolute; right: 1rem; top: 1rem; background: rgba(47, 71, 112, 0.82); color: #fff; font-size: 0.82rem; padding: 0.35rem 0.75rem; border-radius: 999px; }

  .vb .b-abschnitt { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .vb .b-titel { font-size: clamp(1.75rem, 3.2vw, 2.5rem); font-weight: 650; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .vb .b-titel::before { content: ''; display: block; width: 2.5rem; height: 4px; border-radius: 4px; background: var(--teal-hell); margin-bottom: 1rem; }
  .vb .b-themen { background: #fff; }
  .vb .b-gruppe + .b-gruppe { margin-top: 2.75rem; }
  .vb .b-gruppe-titel { display: flex; align-items: center; gap: 0.75rem; font-size: 1.2rem; font-weight: 600; margin-bottom: 1.1rem; }
  .vb .b-icon-kreis { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: #e6f1f4; color: var(--teal); flex: none; }
  .vb .b-icon-kreis.gross { width: 3rem; height: 3rem; }
  .vb .b-karten { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .vb .b-karte { position: relative; display: flex; flex-direction: column; background: var(--grund); border: 1px solid var(--linie); border-radius: 20px; padding: 1.6rem; transition: transform 0.25s var(--weich), box-shadow 0.25s var(--weich), background-color 0.25s var(--weich); }
  .vb .b-karte::before { content: ''; position: absolute; left: 0; top: 1.6rem; bottom: 1.6rem; width: 3px; border-radius: 0 3px 3px 0; background: var(--teal-hell); opacity: 0; transition: opacity 0.25s var(--weich); }
  .vb .b-karte:hover { transform: translateY(-3px); box-shadow: var(--schatten); background: #fff; }
  .vb .b-karte:hover::before { opacity: 1; }
  .vb .b-karte h4 { margin: 0 0 0.6rem; font-size: 1.12rem; line-height: 1.3; font-weight: 600; color: var(--navy); }
  .vb .b-karte h4 a { color: inherit; text-decoration: none; }
  .vb .b-karte h4 a::after { content: ''; position: absolute; inset: 0; border-radius: 20px; }
  .vb .b-karte p { color: var(--text-leise); font-size: 0.96rem; margin: 0 0 1.2rem; }
  .vb .b-karte-mehr { margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem; color: var(--teal); font-weight: 600; font-size: 0.92rem; }
  .vb .b-karte:focus-within { outline: 3px solid var(--teal-hell); outline-offset: 3px; }
  .vb .b-karte h4 a:focus-visible { outline: none; }

  .vb .b-ablauf { background: #eef3f7; }
  .vb .b-ablauf-raster { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .vb .b-schritte { list-style: none; margin: 0; padding: 0; position: relative; }
  .vb .b-schritte::before { content: ''; position: absolute; left: 1.5rem; top: 1.5rem; bottom: 1.5rem; width: 2px; background: #cfdde6; }
  .vb .b-schritte li { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: 1.25rem; padding: 0 0 2rem; }
  .vb .b-schritte li:last-child { padding-bottom: 0; }
  .vb .b-schritte .b-icon-kreis { background: #fff; box-shadow: 0 0 0 6px #eef3f7; position: relative; }
  .vb .b-schritte h3 { font-size: 1.2rem; font-weight: 600; margin: 0.15rem 0 0.35rem; }
  .vb .b-schritt-nr { display: block; font-size: 0.8rem; font-weight: 600; color: var(--teal); letter-spacing: 0.04em; margin-bottom: 0.15rem; }
  .vb .b-schritte p { margin: 0; color: var(--text-leise); }
  .vb .b-ablauf-bild { margin: 0; }
  .vb .b-ablauf-bild img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 24px; box-shadow: var(--schatten); }

  .vb .b-wer { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: clamp(1.75rem, 5vw, 4rem); align-items: center; background: #fff; border: 1px solid var(--linie); border-radius: 32px; padding: clamp(1.25rem, 3vw, 2rem); box-shadow: var(--schatten); }
  .vb .b-wer-bild { margin: 0; }
  .vb .b-wer-bild img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 22px; }
  .vb .b-wer-text { padding: clamp(0.5rem, 2vw, 1.5rem) clamp(0.25rem, 2vw, 1.5rem) clamp(0.5rem, 2vw, 1.5rem) 0; }
  .vb .b-wer-text .bewertungszeile { margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid var(--linie); }
  .vb .b-mehr { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; }

  .vb .b-faq-abschnitt { padding-top: 0; }
  .vb .b-faq { margin: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(2, 1fr); }
  .vb .b-faq div { background: #fff; border: 1px solid var(--linie); border-radius: 20px; padding: 1.5rem; }
  .vb .b-faq dt { font-weight: 600; color: var(--navy); font-size: 1.08rem; margin-bottom: 0.45rem; }
  .vb .b-faq dd { margin: 0; color: var(--text-leise); }

  .vb .b-abschluss { background: var(--verlauf); color: #fff; padding: clamp(3.5rem, 8vw, 6rem) 0; text-align: center; }
  .vb .b-abschluss h2 { color: #fff; font-size: clamp(1.9rem, 3.6vw, 2.8rem); margin-bottom: 1rem; }
  .vb .b-abschluss-innen > p { max-width: 36rem; margin-left: auto; margin-right: auto; font-size: 1.1rem; }
  .vb .b-auf-dunkel { justify-content: center; color: #e6edf5; margin-top: 1.4rem; }
  .vb .b-auf-dunkel strong, .vb .b-auf-dunkel .sterne, .vb .b-auf-dunkel a { color: #fff; }
  .vb .fuss { background: #263b5e; }

  @media (max-width: 900px) {
    .vb .b-hero-raster, .vb .b-ablauf-raster, .vb .b-wer { grid-template-columns: 1fr; }
    .vb .b-hero-bild { max-width: 28rem; }
    .vb .b-faq { grid-template-columns: 1fr; }
    .vb .b-wer-text { padding: 0 0.5rem 0.5rem; }
    .vb .b-wer-bild img { aspect-ratio: 4 / 3; }
  }
</style>
