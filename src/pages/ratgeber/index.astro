---
// Ratgeber-Übersicht: alle Fragen nach Thema, mit Berufsphase, Kurzantwort und Link.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { visible } from '../../lib/status';
import { gruppiere, phaseJeSeite } from '../../lib/phasen';
import { SITE_URL } from '../../lib/site';
import { organisation } from '../../lib/schema';

const seiten = visible(await getCollection('situationen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const gruppen = gruppiere(seiten);
const jsonLd = [
  organisation(),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Ratgeber für Zahnärzt*innen',
    url: `${SITE_URL}/ratgeber`,
    inLanguage: 'de',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: seiten.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.frage, url: `${SITE_URL}/ratgeber/${s.id}` })),
    },
  },
];
---
<Base title="Ratgeber für Zahnärzt*innen | zahnarzt-versicherungen.de" description="Antworten auf typische Fragen zu Versicherungen und Absicherung für Zahnärzt*innen in verschiedenen Berufsphasen." path="/ratgeber" jsonLd={jsonLd} krumen={[{ name: 'Ratgeber', href: '/ratgeber' }]}>
  <div class="rahmen">
    <header class="seitenkopf">
      <h1>Ratgeber für Zahnärzt*innen</h1>
      <p class="einleitung">Antworten auf typische Fragen zu Versicherungen und Absicherung für Zahnärzt*innen in verschiedenen Berufsphasen.</p>
    </header>
    {gruppen.map((g) => (
      <section class="themengruppe" aria-labelledby={`thema-${g.id}`}>
        <h2 class="themengruppe-titel" id={`thema-${g.id}`}><Icon name={g.icon} size={22} />{g.titel}</h2>
        <ul class="karten">
          {g.seiten.map((s) => (
            <li class="karte">
              <p class="karte-phase">{phaseJeSeite[s.id] ?? 'Jede Berufsphase'}</p>
              <h3><a href={`/ratgeber/${s.id}`}>{s.data.frage}</a></h3>
              <p>{s.data.kurzantwort}</p>
              <span class="karte-pfeil" aria-hidden="true"><Icon name="pfeil" size={18} /></span>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <CtaBlock text="Du möchtest wissen, was für deine Situation gilt? Im Erstgespräch gehen wir sie gemeinsam durch." />
  </div>
</Base>
