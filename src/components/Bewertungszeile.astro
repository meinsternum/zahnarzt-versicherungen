---
// Google-Bewertungen (Werte aus src/lib/bewertung.ts). Statischer Text, kein Widget, kein Schema.
// Die Bewertungen gelten für das Team der MEIN STERNUM Finanzberatung GmbH, nicht für diese Website.
import { bewertung as b } from '../lib/bewertung';
interface Props { dunkel?: boolean; class?: string }
const { dunkel = false, class: klasse = '' } = Astro.props;
---
<div class={`bewertung ${dunkel ? 'dunkel' : ''} ${klasse}`}>
  <p class="bewertung-note" aria-hidden="true">{b.wert}</p>
  <div class="bewertung-text">
    <p class="bewertung-sterne"><span aria-hidden="true">★★★★★</span><span class="sr">{b.wert} von 5 Sternen</span></p>
    <p class="bewertung-anzahl"><strong>{b.anzahl} Google-Bewertungen</strong> für unser Team</p>
    <p class="bewertung-stand">Stand {b.stand} · <a href={b.url}>Bewertungen bei Google ansehen</a></p>
  </div>
</div>
