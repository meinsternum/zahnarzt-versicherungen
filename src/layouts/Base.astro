---
// Standard-Layout für alle Seiten: Kopf mit Navigation und Termin-Button (sticky), Brotkrumen, Fuß.
// Alle Inhalte stehen als statisches HTML im Quelltext; das kleine Skript blendet nur ein.
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import '../styles/site.css';
import CookieBanner from '../components/CookieBanner.astro';
import Brotkrumen from '../components/Brotkrumen.astro';
import { isProduction, indexierungErlaubt, zeigeUeberUns } from '../lib/status';
import { TERMIN_URL, ORGANISATION as O, KI_HINWEIS, PFLICHTHINWEIS, SITE_URL, SOCIAL } from '../lib/site';
import { breadcrumbs, type Krume } from '../lib/schema';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { visible } from '../lib/status';
import { gruppiere, menueTitel } from '../lib/phasen';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: object[];
  krumen?: Krume[]; // ohne Startseite; leer = keine Brotkrumen (Startseite)
  ogTyp?: 'website' | 'article';
}

const { title, description, path, noindex = false, jsonLd = [], krumen = [], ogTyp = 'website' } = Astro.props;
const suffix = ' | zahnarzt-versicherungen.de';
const basis = title.endsWith(suffix) ? title.slice(0, -suffix.length) : title;
// Domain-Zusatz nur, wenn der Titel danach höchstens 60 Zeichen hat (sonst kürzt Google).
const fullTitle = (basis + suffix).length <= 60 ? basis + suffix : basis;
const canonical = new URL(path, SITE_URL).toString();
// Außerhalb des Live-Builds nie indexieren.
const robots = noindex || !isProduction || !indexierungErlaubt ? 'noindex, nofollow' : 'index, follow';

const alleKrumen: Krume[] = krumen.length ? [{ name: 'Startseite', href: '/' }, ...krumen] : [];
const schema = [...jsonLd, ...(alleKrumen.length ? [breadcrumbs(alleKrumen)] : [])];

const nav = [
  { href: '/', text: 'Startseite' },
  { href: '/ratgeber', text: 'Ratgeber' },
  ...(zeigeUeberUns ? [{ href: '/ueber-uns', text: 'Über uns' }] : []),
  { href: '/kontakt', text: 'Kontakt' },
];
const aktiv = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const aktuell = (href: string) => (path === href ? 'page' : aktiv(href) ? 'true' : undefined);
// Mega-Menü: alle sichtbaren Ratgeberseiten nach Thema (gleiche Ordnung wie die Ratgeber-Übersicht).
const menueSeiten = visible(await getCollection('situationen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const menueGruppen = gruppiere(menueSeiten);
const ratgeberAktiv = aktiv('/ratgeber');
const label = (s: (typeof menueSeiten)[number]) => menueTitel[s.id] ?? s.data.titel;
const firma = O.name.replace('MEIN STERNUM', 'MEIN STERNUM');
const profile = SOCIAL.filter((s) => s.url);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogTyp} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="zahnarzt-versicherungen.de" />
    <meta property="og:image" content={new URL('/favicon-512.png', SITE_URL).toString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {schema.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    <CookieBanner />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="rahmen kopf-innen">
        <a class="marke" href="/">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span class="wortmarke"><span>zahnarzt</span><b>versicherungen</b></span>
        </a>
        <nav class="hauptnav" aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => n.href === '/ratgeber' ? (
              <li class="mega-li">
                <details class="mega" data-menue>
                  <summary class:list={['mega-knopf', { aktiv: ratgeberAktiv }]}>Ratgeber<Icon name="runter" size={16} /></summary>
                  <div class="mega-panel">
                    <div class="rahmen mega-raster">
                      <div class="mega-themen">
                        {menueGruppen.map((g) => (
                          <div class="mega-thema">
                            <p class="mega-kopf"><a href={`/ratgeber#thema-${g.id}`}><span class="mega-symbol"><Icon name={g.icon} size={18} /></span>{g.titel}</a></p>
                            <ul>
                              {g.seiten.map((s) => <li><a href={`/ratgeber/${s.id}`} aria-current={path === `/ratgeber/${s.id}` ? 'page' : undefined}>{label(s)}</a></li>)}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <div class="mega-seite">
                        <p class="mega-seite-titel">Deine Situation ist anders?</p>
                        <p>Eine Ratgeberseite erklärt die Regeln. Deine persönliche Situation gehen wir im Erstgespräch gemeinsam durch.</p>
                        <p><a class="knopf knopf-klein" href={TERMIN_URL}>Erstgespräch buchen<Icon name="pfeil" size={16} /></a></p>
                        <p><a class="mega-alle" href="/ratgeber" aria-current={path === '/ratgeber' ? 'page' : undefined}>Alle Fragen im Überblick<Icon name="pfeil" size={16} /></a></p>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ) : <li><a href={n.href} aria-current={aktuell(n.href)}>{n.text}</a></li>)}
          </ul>
        </nav>
        <a class="knopf knopf-klein kopf-termin" href={TERMIN_URL}>Termin buchen</a>
        <details class="menue" data-menue>
          <summary aria-label="Menü"><span class="menue-strich" aria-hidden="true"></span><span class="menue-text">Menü</span></summary>
          <nav aria-label="Hauptnavigation mobil">
            <ul>
              {nav.map((n) => n.href === '/ratgeber' ? (
                <li class="menue-ratgeber">
                  <a href="/ratgeber" aria-current={aktuell('/ratgeber')}>Ratgeber: alle Fragen</a>
                  {menueGruppen.map((g) => (
                    <details class="menue-thema">
                      <summary><span class="mega-symbol"><Icon name={g.icon} size={16} /></span>{g.titel}<Icon name="runter" size={16} /></summary>
                      <ul>
                        {g.seiten.map((s) => <li><a href={`/ratgeber/${s.id}`} aria-current={path === `/ratgeber/${s.id}` ? 'page' : undefined}>{label(s)}</a></li>)}
                      </ul>
                    </details>
                  ))}
                </li>
              ) : <li><a href={n.href} aria-current={aktuell(n.href)}>{n.text}</a></li>)}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    {alleKrumen.length > 0 && <Brotkrumen krumen={alleKrumen} />}

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <footer class="fuss">
      <div class="rahmen fuss-raster">
        <div>
          <p class="fuss-marke"><a href="/"><img src="/favicon.svg" alt="" width="36" height="36" loading="lazy" /><span class="wortmarke-text"><span>zahnarzt</span><b>versicherungen</b></span></a></p>
          <p>Ein Angebot der <a href={O.url}>{firma}</a><br />{O.strasse}, {O.plz} {O.ort}</p>
          <p><a href={O.telefonLink}>{O.telefon}</a><br /><a href={`mailto:${O.email}`}>{O.email}</a></p>
          {profile.length > 0 && <p>{profile.map((s, i) => <>{i > 0 && ' · '}<a href={s.url}>{s.name}</a></>)}</p>}
          <p><a class="knopf knopf-hell knopf-klein" href={TERMIN_URL}>Termin buchen</a></p>
        </div>
        <div>
          <p class="fuss-titel">Seite</p>
          <ul>
            <li><a href="/ratgeber">Ratgeber: alle Fragen</a></li>
            {zeigeUeberUns && <li><a href="/ueber-uns">Über uns</a></li>}
            <li><a href="/kontakt">Kontakt</a></li>
            <li><a href="/impressum">Impressum</a></li>
            <li><a href="/datenschutz">Datenschutz</a></li>
            <li><a href="/erstinformation">Erstinformation</a></li>
          </ul>
        </div>
      </div>
      <div class="rahmen fuss-unten">
        <p>{PFLICHTHINWEIS}</p>
        <p class="ki">{KI_HINWEIS}</p>
      </div>
    </footer>
    <script is:inline>
      // Menüs: Escape und Klick außerhalb schließen, nur ein Menü gleichzeitig offen.
      // Ohne Skript funktionieren beide Menüs per Klick (details/summary).
      (function () {
        var menues = Array.prototype.slice.call(document.querySelectorAll('details[data-menue]'));
        menues.forEach(function (m) {
          m.addEventListener('toggle', function () {
            if (m.open) menues.forEach(function (x) { if (x !== m) x.open = false; });
          });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          menues.forEach(function (m) { if (m.open) { m.open = false; m.querySelector('summary').focus(); } });
        });
        document.addEventListener('click', function (e) {
          menues.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; });
        });
      })();
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.remove('js');
          return;
        }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('sichtbar'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.einblenden').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
