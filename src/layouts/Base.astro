---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { isProduction, indexierungErlaubt, zeigeUeberUns } from '../lib/status';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: object[];
  fullWidth?: boolean;
}

const { title, description, path, noindex = false, jsonLd = [], fullWidth = false } = Astro.props;
const suffix = ' | zahnarzt-versicherungen.de';
const basis = title.endsWith(suffix) ? title.slice(0, -suffix.length) : title;
// Domain-Zusatz nur, wenn der Titel danach höchstens 60 Zeichen hat (sonst kürzt Google).
const fullTitle = (basis + suffix).length <= 60 ? basis + suffix : basis;
const canonical = new URL(path, 'https://zahnarzt-versicherungen.de').toString();
// Außerhalb des Live-Builds nie indexieren.
const robots = noindex || !isProduction || !indexierungErlaubt ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <CookieBanner />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label="zahnarzt versicherungen, Startseite"><img src="/favicon.svg" alt="" width="36" height="36" /><span class="wortmarke"><span>zahnarzt</span><b>versicherungen</b></span></a>
        <nav><a href="/ratgeber">Ratgeber</a>{zeigeUeberUns && <a href="/ueber-uns">Über uns</a>}</nav>
      </div>
    </header>
    <main class={fullWidth ? 'voll' : ''}>
      {fullWidth ? <slot /> : <div class="wrap"><slot /></div>}
    </main>
    <footer class="site">
      <div class="wrap">
        <p>Ein Angebot der MEIN STERNUM Finanzberatung GmbH, Göppinger Str. 2a, 50739 Köln.</p>
        <p>
          {zeigeUeberUns && <><a href="/ueber-uns">Über uns</a> · </>}
          <a href="/impressum">Impressum</a> ·
          <a href="/datenschutz">Datenschutz</a> ·
          <a href="/erstinformation">Erstinformation</a>
        </p>
          <p class="hinweis">Die Inhalte dieser Seite sind allgemeine Informationen und ersetzen keine individuelle Beratung.</p>
      </div>
    </footer>
  </body>
</html>
