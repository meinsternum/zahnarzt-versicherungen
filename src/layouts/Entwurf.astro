---
// Layout für die Startseiten-Entwürfe (Meilenstein 2). Immer noindex, nicht in der Sitemap.
// Header und Footer sind Vorstufen für Meilenstein 3; die gewählte Variante wird dort zum Standard-Layout.
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/entwurf-basis.css';
import { TERMIN_URL, ORGANISATION as O, KI_HINWEIS, PFLICHTHINWEIS, SITE_URL } from '../lib/site';
import { zeigeUeberUns } from '../lib/status';

interface Props {
  title: string;
  description: string;
  variante: 'a' | 'b';
  bezeichnung: string;
  jsonLd?: object[];
}
const { title, description, variante, bezeichnung, jsonLd = [] } = Astro.props;
const canonical = new URL('/', SITE_URL).toString();
const nav = [
  { href: '/', text: 'Startseite' },
  { href: '/ratgeber', text: 'Ratgeber' },
  ...(zeigeUeberUns ? [{ href: '/ueber-uns', text: 'Über uns' }] : []),
  { href: '#kontakt', text: 'Kontakt' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {jsonLd.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body class={`v${variante}`}>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <p class="entwurf-leiste">{bezeichnung}: nicht indexiert, nur zur Auswahl. Neue Texte sind als „Entwurf zur Freigabe“ markiert.</p>
    <header class="kopf">
      <div class="rahmen kopf-innen">
        <a class="marke" href="/">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span class="wortmarke"><span>zahnarzt</span><b>versicherungen</b></span>
        </a>
        <nav class="hauptnav" aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={n.href === '/' ? 'page' : undefined}>{n.text}</a></li>)}
          </ul>
        </nav>
        <a class="knopf knopf-klein kopf-termin" href={TERMIN_URL}>Termin buchen</a>
        <details class="menue">
          <summary aria-label="Menü öffnen"><span class="menue-strich" aria-hidden="true"></span><span class="menue-text">Menü</span></summary>
          <nav aria-label="Hauptnavigation mobil">
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.text}</a></li>)}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss" id="kontakt">
      <div class="rahmen fuss-raster">
        <div>
          <p class="fuss-marke"><span>zahnarzt</span><b>versicherungen</b></p>
          <p>Ein Angebot der {O.name.replace('MEIN STERNUM', 'MEIN\u00a0STERNUM')}<br />{O.strasse}, {O.plz} {O.ort}</p>
          <p><a href={O.telefonLink}>{O.telefon}</a><br /><a href={`mailto:${O.email}`}>{O.email}</a></p>
          <p><a class="knopf knopf-hell knopf-klein" href={TERMIN_URL}>Termin buchen</a></p>
        </div>
        <div>
          <p class="fuss-titel">Seite</p>
          <ul>
            {zeigeUeberUns && <li><a href="/ueber-uns">Über uns</a></li>}
            <li><a href="/ratgeber">Alle Fragen im Ratgeber</a></li>
            <li><a href="/impressum">Impressum</a></li>
            <li><a href="/datenschutz">Datenschutz</a></li>
            <li><a href="/erstinformation">Erstinformation</a></li>
          </ul>
        </div>
      </div>
      <div class="rahmen fuss-unten">
        <p>{PFLICHTHINWEIS}</p>
        <p class="ki">{KI_HINWEIS}</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.remove('js');
          return;
        }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('sichtbar'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.einblenden').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
